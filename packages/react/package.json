    "@dexa-ui/css": "workspace:*",
    "@dexa-ui/locales": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kerimkuscu/dexa-ui.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
